# --- Secrets & Environment ---
.env
*.env
*.pem
*.key

# --- PHI & Large Dataset Folders ---
# Never commit raw or processed patient data
data/
output/
quarantine/
postgres_data/

# Global file ignore for medical assets
*.dcm
*.pdf

# Explicit Whitelist for repo documentation & test fixtures
!report.pdf
!docs/*.pdf
!tests/fixtures/*.dcm
!tests/fixtures/*.pdf
!tests/sample_input.dcm

# --- Python Artifacts & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- OS & Editor Noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.ipynb_checkpoints/